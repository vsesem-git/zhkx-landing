# Зависимости (нужны только для тестов: npm install)
node_modules/
package-lock.json

# Служебные файлы ОС/редакторов
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Локальные выгрузки и бэкапы данных
*.local.json
zhkx-backup-*.json

# Собранные демо-бандлы и архивы релиза (создаются npm run build:demo)
dist/
*.tar.gz

# Данные сервера: state.js с лицевыми счетами, токен доступа и история ревизий
# (создаются автоматически при первом запуске npm start).
# ВАЖНО: правило привязано к корню репозитория («/data/»), иначе оно случайно
# выкидывало из git data-слой приложения assets/js/data/ — источник правды.
/data/
/data/**
!assets/js/data/
!assets/js/data/**
!docs/assets/js/data/
!docs/assets/js/data/**
