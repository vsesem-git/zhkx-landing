# ============================================================================
#  ЖКУ · Крым — пример обратного прокси на nginx (плюс basic-auth для доступа)
#  ---------------------------------------------------------------------------
#  1. Замените demo.example.com на свой домен.
#  2. Пароль на вход:      sudo htpasswd -c /etc/nginx/.htpasswd-zhkx ваш_логин
#  3. Сертификат:          sudo certbot --nginx -d demo.example.com
#  4. Проверка конфигурации: sudo nginx -t && sudo systemctl reload nginx
#
#  Подсказка: приложение защищено токеном API, но сама страница и справочники
#  (адреса, лицевые счета, ФИО) открыты — поэтому basic-auth здесь не лишний.
# ============================================================================
upstream zhkx_app {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name demo.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name demo.example.com;

    ssl_certificate     /etc/letsencrypt/live/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.com/privkey.pem;

    # Доступ только для своих: личные данные объектов
    auth_basic           "ЖКУ · Крым";
    auth_basic_user_file /etc/nginx/.htpasswd-zhkx;

    client_max_body_size 32m;   # импорт больших бэкапов
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass         http://zhkx_app;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Данные состояния не кэшируем нигде
    location /data/ {
        proxy_pass http://zhkx_app;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
    }

    # Service worker должен отдаваться с областью действия «/»
    location = /sw.js {
        proxy_pass http://zhkx_app;
        proxy_set_header Host $host;
        add_header Service-Worker-Allowed "/" always;
        add_header Cache-Control "no-cache" always;
    }
}
